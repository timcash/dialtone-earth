{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dialtone-earth",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "DIALTONE_AUTH_TOKENS",
      "id": "d806e1d9d36347cc9e4523e62dd6c761"
    }
  ],
  "send_email": [
    {
      "name": "SEND_EMAIL"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/login", "/auth/*"]
  }
}
